<?xml version="1.0" encoding="utf-8"?>
<luzzr.muse.player.FloatingLyricsContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_lyrics_bg"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/lyrics_prev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#73F3ECE4"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="visible" />

        <TextView
            android:id="@+id/lyrics_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="#FFF3ECE4"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="visible" />

        <TextView
            android:id="@+id/lyrics_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#73F3ECE4"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="visible" />

        <View
            android:layout_width="28dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/overlay_drag_handle"
            android:alpha="0.35" />

        <TextView
            android:id="@+id/lyrics_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#80F3ECE4"
            android:text="@string/lyrics_empty_hint"
            android:visibility="gone" />
    </LinearLayout>

</luzzr.muse.player.FloatingLyricsContainer>
