<?xml version="1.0" encoding="utf-8"?>
<!-- 纯透明背景：歌词自身带颜色 + 描边保证可读 -->
<luzzr.muse.player.FloatingLyricsContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clipToPadding="false"
    android:background="@drawable/overlay_lyrics_bg">

    <LinearLayout
        android:id="@+id/lyrics_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="180dp"
        android:maxWidth="360dp"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:gravity="center_horizontal"
        android:elevation="0dp">

        <LinearLayout
            android:id="@+id/lyrics_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/btn_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:minHeight="48dp"
                android:paddingVertical="12dp"
                android:text="@string/floating_lyrics_lock"
                android:textSize="12sp"
                android:textColor="#FFF3ECE4"
                android:background="@drawable/overlay_chip_bg"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btn_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:minHeight="48dp"
                android:paddingVertical="12dp"
                android:text="@string/floating_lyrics_close"
                android:textSize="12sp"
                android:textColor="#FFF3ECE4"
                android:background="@drawable/overlay_chip_bg"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- 锁定时无 UI 提示，解锁入口在通知栏 -->
        <TextView
            android:id="@+id/lyrics_lock_indicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <luzzr.muse.player.FloatingLyricsView
            android:id="@+id/lyrics_render"
            android:layout_width="wrap_content"
            android:layout_height="148dp"
            android:minWidth="180dp"
            android:contentDescription="@string/floating_lyrics_accessibility" />

        <View
            android:id="@+id/drag_handle"
            android:layout_width="24dp"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/overlay_drag_handle"
            android:alpha="0.55" />

        <TextView
            android:id="@+id/lyrics_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#CCB89A77"
            android:text="@string/lyrics_empty_hint"
            android:visibility="gone"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1.5"
            android:shadowRadius="5" />
    </LinearLayout>

</luzzr.muse.player.FloatingLyricsContainer>
