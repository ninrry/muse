<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating lyrics overlay layout (悬浮歌词)
  Semi-transparent card that displays synced lyrics above all apps.
  Shows current line (highlighted) + previous/next lines for context.
-->
<luzzr.muse.player.FloatingLyricsContainer xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false">

    <!-- Glass card background with rounded corners -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_lyrics_bg"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        tools:ignore="UselessParent">

        <!-- Previous line -->
        <TextView
            android:id="@+id/lyrics_prev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#A0FFFFFF"
            android:lines="1"
            android:ellipsize="end"
            android:visibility="visible" />

        <!-- Current line (highlighted) -->
        <TextView
            android:id="@+id/lyrics_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:lines="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:visibility="visible" />

        <!-- Next line -->
        <TextView
            android:id="@+id/lyrics_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#A0FFFFFF"
            android:lines="1"
            android:ellipsize="end"
            android:visibility="visible" />

        <!-- Drag handle indicator (bottom dot) -->
        <View
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="-8dp"
            android:background="@drawable/overlay_drag_handle"
            android:alpha="0.4" />

        <!-- Empty state hint -->
        <TextView
            android:id="@+id/lyrics_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#80FFFFFF"
            android:text="@string/lyrics_empty_hint"
            android:visibility="gone" />

    </FrameLayout>

</luzzr.muse.player.FloatingLyricsContainer>
